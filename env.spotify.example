# Spotify Song Queue — local secrets
# Put these in ".env.local" (gitignored) for local autocomplete search via Vite.
# Also add the same names as Supabase Edge Function Secrets for production.

# Spotify Developer Dashboard → Create app
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Venue Premium account: Authorization Code flow once, then store refresh token.
# Required scopes: user-modify-playback-state user-read-playback-state
# Only needed for "Send to Spotify" staff action.
SPOTIFY_REFRESH_TOKEN=

# Optional redirect URI used when obtaining the refresh token:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3911/callback
#
# Generate refresh token once:
#   npm run spotify:refresh-token
# Then paste SPOTIFY_REFRESH_TOKEN into .env.local and Supabase Edge secrets.
